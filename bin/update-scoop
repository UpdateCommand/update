#!/bin/sh
set -euf

# Update Scoop and its package buckets on Windows.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-scoop
#
# Example:
#
#     update-scoop
#
# Needs: scoop.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Update Scoop and its package buckets on Windows.

Syntax:

    update-scoop

Example:

    update-scoop

Needs: scoop.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Scoop package manager for Windows
if command -v scoop >/dev/null 2>&1; then
   scoop update
fi

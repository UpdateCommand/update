#!/bin/sh
set -euf

# Install all macOS software updates (can be large downloads).
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-macos
#
# Example:
#
#     sudo update-macos
#
# Needs: softwareupdate; macOS; root (e.g. sudo).
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Install all macOS software updates (can be large downloads).

Syntax:

    update-macos

Example:

    sudo update-macos

Needs: softwareupdate; macOS; root (e.g. sudo).
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# macOS Software Update
if command -v softwareupdate >/dev/null 2>&1; then
    softwareupdate --install --all
fi

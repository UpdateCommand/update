#!/bin/sh
set -euf

# Refresh Helm chart repositories for Kubernetes.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-helm
#
# Example:
#
#     update-helm
#
# Needs: helm.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Refresh Helm chart repositories for Kubernetes.

Syntax:

    update-helm

Example:

    update-helm

Needs: helm.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Update Helm charts.
#
# Helm is a Kubernetes package manager that simplifies the deployment of applications.
# This script checks for Helm installation, then runs `helm repo update`
# to update the repositories and refresh chart information.
#
if command -v helm >/dev/null 2>&1; then
    helm repo update
fi

#!/bin/sh
set -euf

# Clean and update packages with yum on RedHat, Fedora, CentOS, etc.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-yum
#
# Example:
#
#     sudo update-yum
#
# Needs: yum; root (e.g. sudo).
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Clean and update packages with yum on RedHat, Fedora, CentOS, etc.

Syntax:

    update-yum

Example:

    sudo update-yum

Needs: yum; root (e.g. sudo).
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Yum package manager for RedHat Linux, Fedora Linux, CentOS Linux, etc.
if command -v yum >/dev/null 2>&1; then
    yum --assumeyes clean
    yum --assumeyes --obsolete update
    yum --assumeyes clean
fi

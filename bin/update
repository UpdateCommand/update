#!/bin/sh
set -euf

# Helper Functions for Logging and Execution
log_info() {
    printf "[\033[1;34mINFO\033[0m] %s\n" "$*"
}
log_success() {
    printf "[\033[1;32mSUCCESS\033[0m] %s\n" "$*"
}
log_error() {
    printf "[\033[1;31mERROR\033[0m] %s\n" "$*" >&2
}

run_update() {
    cmd="$1"
    # Find the command either in PATH, or relative to the script directory
    script_path=""
    if command -v "$cmd" >/dev/null 2>&1; then
        script_path="$cmd"
    elif [ -x "$(dirname "$0")/$cmd" ]; then
        script_path="$(dirname "$0")/$cmd"
    fi

    if [ -n "$script_path" ]; then
        if [ "$dry_run" -eq 1 ]; then
            log_info "[DRY-RUN] Would execute $cmd"
        else
            log_info "Running $cmd..."
            if "$script_path"; then
                log_success "Completed $cmd."
            else
                log_error "Failed $cmd."
            fi
        fi
    else
        # If the script isn't found at all, just skip quietly like before
        :
    fi
}

run_update_async() {
    cmd="$1"
    script_path=""
    if command -v "$cmd" >/dev/null 2>&1; then
        script_path="$cmd"
    elif [ -x "$(dirname "$0")/$cmd" ]; then
        script_path="$(dirname "$0")/$cmd"
    fi

    if [ -n "$script_path" ]; then
        if [ "$dry_run" -eq 1 ]; then
            log_info "[DRY-RUN] Would execute $cmd in background"
        else
            log_info "Starting $cmd in background..."
            (
                tmp_log=$(mktemp)
                if "$script_path" > "$tmp_log" 2>&1; then
                    log_success "Completed $cmd."
                else
                    log_error "Failed $cmd. Output:"
                    cat "$tmp_log" >&2
                fi
                rm -f "$tmp_log"
            ) &
        fi
    else
        :
    fi
}

run_maybe_async() {
    if [ "$concurrent" -eq 1 ]; then
        run_update_async "$1"
    else
        run_update "$1"
    fi
}

## Program Tracking

program_command="update"
program_version="8.0.1"
program_updated="2025-02-27T14:23:13Z"
program_license="GPL-2.0-or-later or contact us for custom"
program_contact="Joel Parker Henderson (https://joelparkerhenderson.com)"

## Help Function

help(){
cat << EOF

Update Command

Run update commands for everything we use on all platforms.

Guidance:

  * Each script should be testing that it has what it needs to run.
    This includes testing for any platform-specific needs.

  * Each script should try to clean before running and after running.
    This helps create disk space, and helps maintain dependencies.

We welcome patches, pull requests, and ideas.


## Options

  * --foo=<value>:
      set the foo variable to a value

  * -h --help:
      print helpful information

  * -v --version:
      print the program version number

  * --program-command:
      print the program command name

  * --program-version:
      print the program version number

  * --program-updated:
      print the program updated date

  * --program-license:
      print the program license name

  * --program-contact:
      print the program contact information for the maintainer

Heuristics for ordering:

  1. Run all user scripts in <config>/run/start

  2. Update OS e.g. Ubuntu \`do-release-upgrade\`, macOS \`softwareupdate\`.

  3. Update system packages e.g. Debian \`apt\`, RedHat \`yum\`, macOS \`brew\`.

  4. Update shells e.g. Z Shell.

  5. Update languages e.g. Rust.

  6. Update tool packages: e.g. Node \`npm\`, Python \`pip\`, Ruby \`gem\`.

  7. Update repositories: \`/opt\`, \`~/git\`, etc.

  2. Run all user scripts in ~/.config/updatecommand/run/finish

## Tracking

  * Command: $program_command
  * Version: $program_version
  * Updated: $program_updated
  * License: $program_license
  * Contact: $program_contact
EOF
}

concurrent=0
dry_run=0

## Options
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      help; exit 0
      ;;
    -v|--version)
      echo "$program_version"; exit 0
      ;;
    --concurrent)
      concurrent=1
      ;;
    --dry-run)
      dry_run=1
      ;;
    --program-command)
      echo "$program_command"; exit 0
      ;;
    --program-version)
      echo "$program_version"; exit 0
      ;;
    --program-updated)
      echo "$program_updated"; exit 0
      ;;
    --program-license)
      echo "$program_license"; exit 0
      ;;
    --program-contact)
      echo "$program_contact"; exit 0
      ;;
    --*=*)
      key="${arg#--}"; key="${key%%=*}";
      val="${arg#*=}";
      eval "$key"=\$val
      ;;
  esac
done

## Update operating system
run_update update-ubuntu-release
run_update update-debian-release
run_update update-macos


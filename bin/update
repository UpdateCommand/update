run_maybe_async update-yarn

# Update repositories
run_update update-hg-pull
run_update update-git-pull

# Update individual programs
run_update update-az
run_update update-playwright-via-pnpm

if [ "$concurrent" -eq 1 ]; then
    log_info "Waiting for concurrent tasks to finish..."
    wait
    log_success "All concurrent tasks finished."
fi

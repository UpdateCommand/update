#!/bin/sh
set -euf

# Upgrade opkg packages on embedded Linux devices.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-opkg
#
# Example:
#
#     sudo update-opkg
#
# Needs: opkg; root.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Upgrade opkg packages on embedded Linux devices.

Syntax:

    update-opkg

Example:

    sudo update-opkg

Needs: opkg; root.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# opkg lightweight package management - for embedded Linux devices
if command -v opkg >/dev/null 2>&1; then
   opkg upgrade
fi

#!/bin/sh
set -euf

# Update the Claude Code command line tool.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-claude
#
# Example:
#
#     update-claude
#
# Needs: claude.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Update the Claude Code command line tool.

Syntax:

    update-claude

Example:

    update-claude

Needs: claude.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

if command -v claude >/dev/null 2>&1; then
    claude update
fi

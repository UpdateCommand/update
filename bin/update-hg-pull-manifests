#!/bin/sh
set -euf

# Run "hg pull -u" in each directory listed in manifest files.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-hg-pull-manifests
#
# Example:
#
#     echo ~/git/my-project >> ${XDG_CONFIG_HOME:-$HOME/.config}/update-hg-pull-manifests/projects.txt && update-hg-pull-manifests
#
# Needs: hg; manifest files.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.
#
# Manifest directory: ${XDG_CONFIG_HOME:-$HOME/.config}/update-hg-pull-manifests/.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Run "hg pull -u" in each directory listed in manifest files.

Syntax:

    update-hg-pull-manifests

Example:

    echo ~/git/my-project >> ${XDG_CONFIG_HOME:-$HOME/.config}/update-hg-pull-manifests/projects.txt && update-hg-pull-manifests

Needs: hg; manifest files.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.

Manifest directory: ${XDG_CONFIG_HOME:-$HOME/.config}/update-hg-pull-manifests/.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Run update-hg-pull with manifests:
#
#     $XDG_CONFIG_HOME/update-hg-pull-manifests/*
#     $HOME/update-hg-pull-manifests/*
#
# For example:
#
#     ~/update-hg-pull-manifests/foo.txt
#     ~/update-hg-pull-manifests/bar.txt
#
# Each manifest file is simply a list of local project directories.
# The program skips lines that are comments (begin with #) or blank.

program_command="$(basename "$0")"
program_config="${XDG_CONFIG_HOME:-$HOME/.config}/$program_command"

update_hg_pull_manifests() {
    manifests_to_lines |
    while read -r line; do
        cd "$line" 2>/dev/null && 
        update_hg_pull
    done
}

update_hg_pull() {
    if command -v hg >/dev/null 2>&1; then
        hg pull -u
    fi
}

manifests_to_lines() {
    find "$program_config" -type f -exec cat {} \; 2>/dev/null |
    grep '^[:space]*[^#[:space:]]' 
}

update_hg_pull_manifests

#!/bin/sh
set -euf

# Warn if the installed Swift version differs from the expected version.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-swift
#
# Example:
#
#     update-swift
#
# Needs: xcrun; macOS with Xcode.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.
#
# Edit expect_version inside the script to match the version you want.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Warn if the installed Swift version differs from the expected version.

Syntax:

    update-swift

Example:

    update-swift

Needs: xcrun; macOS with Xcode.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.

Edit expect_version inside the script to match the version you want.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Swift progrsmming language

expect_version="3.0.2"

parse_semver(){
    echo $(echo "$1" | sed -n 's/.* \([0-9\.]\+\).*/\1/p')
}

swift_version(){
    echo $(parse_semver "$(xcrun swift -version | head -1)")
}

if command -v xcrun >/dev/null 2>&1; then
    actual_version=$(swift_version)
    if [ "$expect_version" != "$actual_version" ]; then
        echo "Update Swift: expect:$expect_version, actual:$actual_version"
    fi
fi

#!/bin/sh
set -euf

# Update the slackpkg package list on Slackware.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-slackpkg
#
# Example:
#
#     sudo update-slackpkg
#
# Needs: slackpkg; root.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Update the slackpkg package list on Slackware.

Syntax:

    update-slackpkg

Example:

    sudo update-slackpkg

Needs: slackpkg; root.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# slackpkg package manager for Slack Linux.
if command -v slackpkg >/dev/null 2>&1; then
   slackpkg update
fi

#!/bin/sh
set -euf

# Update the Elixir Mix Hex and Rebar tooling.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-mix
#
# Example:
#
#     update-mix
#
# Needs: mix.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Update the Elixir Mix Hex and Rebar tooling.

Syntax:

    update-mix

Example:

    update-mix

Needs: mix.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Mix for Elixir
if command -v mix >/dev/null 2>&1; then
    mix local.hex --force
    mix local.rebar --force
fi

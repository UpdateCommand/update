#!/bin/sh
set -euf

# Sync the xbps package repositories on Void Linux.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-xbps
#
# Example:
#
#     sudo update-xbps
#
# Needs: xbps-install; root.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Sync the xbps package repositories on Void Linux.

Syntax:

    update-xbps

Example:

    sudo update-xbps

Needs: xbps-install; root.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# xbps to build packages for Void Linux.
if command -v xbps-install >/dev/null 2>&1; then
    xbps-install --sync
fi

#!/bin/sh
set -euf

# Run "git pull" in each directory listed in manifest files.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-git-pull-manifests
#
# Example:
#
#     echo ~/git/my-project >> ${XDG_CONFIG_HOME:-$HOME/.config}/update-git-pull-manifests/projects.txt && update-git-pull-manifests
#
# Needs: git; manifest files.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.
#
# Manifest directory: ${XDG_CONFIG_HOME:-$HOME/.config}/update-git-pull-manifests/.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Run "git pull" in each directory listed in manifest files.

Syntax:

    update-git-pull-manifests

Example:

    echo ~/git/my-project >> ${XDG_CONFIG_HOME:-$HOME/.config}/update-git-pull-manifests/projects.txt && update-git-pull-manifests

Needs: git; manifest files.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.

Manifest directory: ${XDG_CONFIG_HOME:-$HOME/.config}/update-git-pull-manifests/.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Run update-git-pull with manifests:
#
#     $XDG_CONFIG_HOME/update-git-pull-manifests/*
#     $HOME/update-git-pull-manifests/*
#
# For example:
#
#     ~/update-git-pull-manifests/foo.txt
#     ~/update-git-pull-manifests/bar.txt
#
# Each manifest file is simply a list of local project directories.
# The program skips lines that are comments (begin with #) or blank.

program_command="$(basename "$0")"
program_config="${XDG_CONFIG_HOME:-$HOME/.config}/$program_command"

update_git_pull_manifests() {
    manifests_to_lines |
    while read -r line; do
        cd "$line" 2>/dev/null && 
        update_git_pull
    done
}

update_git_pull() {
    if command -v git >/dev/null 2>&1; then
        git pull && 
        git submodule update --init --recursive
    fi
}

manifests_to_lines() {
    find "$program_config" -type f -exec cat {} \; 2>/dev/null |
    grep '^[:space]*[^#[:space:]]' 
}

update_git_pull_manifests

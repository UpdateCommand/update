#!/bin/sh
set -euf

# Update globally installed pnpm packages.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-pnpm-global
#
# Example:
#
#     update-pnpm-global
#
# Needs: pnpm.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.
#
# Failures are ignored when no global package.json exists.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Update globally installed pnpm packages.

Syntax:

    update-pnpm-global

Example:

    update-pnpm-global

Needs: pnpm.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.

Failures are ignored when no global package.json exists.
HELP_EOF
            exit 0
            ;;
    esac
fi

# PNPM: Performant Node Package Manager
#
if command -v pnpm >/dev/null 2>&1; then
    # This code is enabled to fail silently because pnpm does not seem to have a
    # simple way to see if a global file is available or not, without an error.
    #
    # If pnpm does not have a global, then the pnpm error message is:
    #
    #     $ pnpm update --global
    #     ERR_PNPM_NO_PKG_MANIFEST  
    #     No package.json found in /var/root/Library/pnpm/global/5
    #
    set +e
    pnpm update --global
    set -e
fi

#!/bin/sh
set -euf

# Update a Svelte project: dependencies, audit, SvelteKit, and migrations.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-svelte-project
#
# Example:
#
#     cd ~/my-project && update-svelte-project
#
# Needs: pnpm and npx; run inside a directory that has svelte.config.js.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.
#
# Migrations may edit your source files. Commit your work first, then review the diff.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Update a Svelte project: dependencies, audit, SvelteKit, and migrations.

Syntax:

    update-svelte-project

Example:

    cd ~/my-project && update-svelte-project

Needs: pnpm and npx; run inside a directory that has svelte.config.js.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.

Migrations may edit your source files. Commit your work first, then review the diff.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Update a Svelte project.
#
# Syntax:
#
#     update-svelte-project
#
# Example:
#
#     $ cd ~/my-svelte-project
#     $ update-svelte-project
#   
# The script does various updates and upgrades.
# The capabilties depend on what you have installed.
# The goal is to have the project fully built and testable.
#
# Example code to find each project and update it:
#
#     find "$HOME" -path '*/.*' -prune -o -type f -name 'svelte.config.js' -exec dirname {} \; | 
#     while read -r x; do 
#         cd "$x" &&
#         update-svelte-project || 
#         true
#     done
#
# Feedback appreciated.

update_svelte_project() {
    # Svelte command line toolchain
    if command -v pnpm >/dev/null 2>&1 &&
       command -v npx >/dev/null 2>&1
    then
        # Is this command running inside a relevant project?
        if [ -e svelte.config.js ]; then
            pnpm install
            pnpm update
            pnpm audit fix --force
            pnpm install @sveltejs/kit@latest svelte@latest
            npx svelte-migrate@latest package
            npx svelte-migrate@latest routes
            npx svelte-migrate@latest self-closing-tags
            npx svelte-migrate@latest app-state
            # npx svelte-migrate@latest sv@latest migrate svelte-5
            # npx sv@latest migrate sveltekit-3 --tasks all --confirm
        fi
    fi
}

update_svelte_project

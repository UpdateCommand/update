#!/bin/sh
set -euf

# Update the Haskell Cabal package list.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-cabal
#
# Example:
#
#     update-cabal
#
# Needs: cabal; must NOT be root.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Update the Haskell Cabal package list.

Syntax:

    update-cabal

Example:

    update-cabal

Needs: cabal; must NOT be root.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Cabal for Haskell
if [ "$(id -u)" -ne 0 ]; then
    if command -v cabal >/dev/null 2>&1; then
        cabal update
    fi
fi

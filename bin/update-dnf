#!/bin/sh
set -euf

# Autoremove and upgrade packages with DNF on Fedora.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-dnf
#
# Example:
#
#     sudo update-dnf
#
# Needs: dnf; root (e.g. sudo).
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Autoremove and upgrade packages with DNF on Fedora.

Syntax:

    update-dnf

Example:

    sudo update-dnf

Needs: dnf; root (e.g. sudo).
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# DNF package manager for Fedora Linux.
if command -v dnf >/dev/null 2>&1; then
    dnf --assumeyes autoremove
    dnf --assumeyes upgrade
    dnf --assumeyes autoremove
fi

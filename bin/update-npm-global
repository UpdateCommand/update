#!/bin/sh
set -euf

# Update npm and globally installed npm packages.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-npm-global
#
# Example:
#
#     update-npm-global
#
# Needs: npm.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Update npm and globally installed npm packages.

Syntax:

    update-npm-global

Example:

    update-npm-global

Needs: npm.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# NPM: Node Package Manager
if command -v npm >/dev/null 2>&1; then
    npm install -g npm
    npm update -g
fi

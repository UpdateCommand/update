#!/bin/sh
set -euf

# Run "pnpm update" in a directory that has package.json.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-pnpm-package
#
# Example:
#
#     cd ~/my-project && update-pnpm-package
#
# Needs: pnpm; run inside a directory that has package.json.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Run "pnpm update" in a directory that has package.json.

Syntax:

    update-pnpm-package

Example:

    cd ~/my-project && update-pnpm-package

Needs: pnpm; run inside a directory that has package.json.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# PNPM: Performant Node Package Manager
if command -v pnpm >/dev/null 2>&1; then
    if [ -r "package.json" ]; then
        pnpm update
    fi
fi

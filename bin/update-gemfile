#!/bin/sh
set -euf

# Run "bundle install" using a Gemfile.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-gemfile
#
# Example:
#
#     update-gemfile
#
# Needs: gem and bundle; a readable Gemfile.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.
#
# Gemfile search order: $GEMFILE, then ${XDG_CONFIG_HOME:-$HOME/.config}/gem/Gemfile.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Run "bundle install" using a Gemfile.

Syntax:

    update-gemfile

Example:

    update-gemfile

Needs: gem and bundle; a readable Gemfile.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.

Gemfile search order: $GEMFILE, then ${XDG_CONFIG_HOME:-$HOME/.config}/gem/Gemfile.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Update via Gemfile by using the `gem` package manager.
#
# Look for a Gemfile in this order:
#
#     $GEMFILE
#     $XDG_CONFIG_HOME/gem/Gemfile
#     $HOME/.config/gem/Gemfile
#
if command -v gem >/dev/null 2>&1; then
    file=${GEMFILE:-${XDG_CONFIG_HOME:-$HOME/.config}/gem/Gemfile}
    if [ -r "$file" ]; then
        (cd "$(dirname "$file")"; bundle install )
    fi
fi

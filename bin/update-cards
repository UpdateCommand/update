#!/bin/sh
set -euf

# Upgrade cards packages on NuTyX Linux.
#
# Run directly or sourced by `update`. Details below; `-h` prints them too.
#
# Syntax:
#
#     update-cards
#
# Example:
#
#     sudo update-cards
#
# Needs: cards; usually root.
# If a needed command is missing, the script does nothing and succeeds.
#
# Help: -h or --help prints this text.

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help)
            cat <<'HELP_EOF'
Upgrade cards packages on NuTyX Linux.

Syntax:

    update-cards

Example:

    sudo update-cards

Needs: cards; usually root.
If a needed command is missing, the script does nothing and succeeds.

Help: -h or --help prints this text.
HELP_EOF
            exit 0
            ;;
    esac
fi

# Cards stands for 'Create, Add, Remove and Download System' packages. It is a
# set of utilities to manage the installed software on your NuTyX Linux system. 
if command -v cards >/dev/null 2>&1; then
   cards upgrade
fi
